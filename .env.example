DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nts_lms
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Required to create a master (trainer/admin) account at /register. Anyone who knows
# this code can create a full-admin account, so keep it secret and rotate it in Coolify
# if it ever leaks -- treat it like a password, not a public setup step.
REGISTRATION_CODE=replace-with-a-long-random-secret

# Production/self-hosted only -- not needed locally. Next.js encrypts variables captured by
# inline Server Actions, and generates a fresh key per build unless this is set. It must be
# available at BUILD time (not just runtime): the key is embedded in the build output.
# Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Endpoint, not account id: https://<account-id>.r2.cloudflarestorage.com
# Must match the variable name configured in Coolify -- see docs/infrastructure.md.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Both are required for real delivery. If either is missing, lib/email.ts silently
# falls back to console-logging the email instead of sending it.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
